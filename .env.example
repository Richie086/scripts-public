# WordPress Webhook Integration
WP_WEBHOOK_URL=https://extremesarcasm.org/index.php?rest_route=/uap/v2/uap-555-559

# Facebook Graph API Credentials
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# X (formerly Twitter) OAuth 1.0a User Context Credentials
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here

# LinkedIn API Credentials
LINKEDIN_PERSON_URN=urn:li:person:your_person_urn_here
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Reddit API Credentials
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_SUBREDDIT=test
REDDIT_USER_AGENT=social-publisher-script:v1.0 (by /u/your_username_here)
